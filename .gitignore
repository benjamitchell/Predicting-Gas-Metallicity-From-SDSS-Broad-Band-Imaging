# Datos pesados (se regeneran con los scripts del pipeline)
data/catalog/*.fits
data/catalog/*.parquet
data/images/
data/processed/*.npy
data/processed/*.npz

# Resultados de entrenamiento
results/**/checkpoints/
results/**/*.pt
results/**/*.ckpt
logs/
slurm_*_out.txt
slurm_*_err.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/

# SO / editores
.DS_Store
Thumbs.db
.vscode/

# Material de referencia del intento original: notebooks pesados (outputs
# embebidos) y el PDF del paper. La auditoria vive en docs/legacy/README.md.
docs/legacy/*.ipynb
docs/legacy/*.pdf
docs/legacy/_stripped/

# Las figuras SI se versionan: son el resultado del proyecto y el README las
# muestra. Son PNG de pocos cientos de KB.

# Predicciones del test: ~120 KB, permiten rehacer el analisis sin reentrenar.
# Los checkpoints (*.pt, cientos de MB) siguen excluidos mas arriba.
